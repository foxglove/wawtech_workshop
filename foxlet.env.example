# Copy to foxlet.env (gitignored) and fill in the token. Used by `docker run --env-file foxlet.env`.
# Docker does not strip quotes in env files, so write the values without any.
# Create the token (admin only) at https://app.foxglove.dev/~/settings/device-tokens:
# "Create device token", leave Device blank. A blank Device needs DEVICE_NAME below.
FOXGLOVE_DEVICE_TOKEN=
DEVICE_NAME=wawtech-workshop
# Only .mcap files count as recordings, and each one uploads automatically.
WATCH_INCLUDE_SUFFIXES=.mcap
WATCH_AUTO_IMPORT_PATTERN=**/*.mcap
FOXGLOVE_LOG_OUTPUT=text
PRIMARY_SITE_MODE=hosted
