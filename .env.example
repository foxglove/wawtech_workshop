# Copy to .env (gitignored) and paste your Foxglove API key after the =
# Needed by upload-episodes, build-dataset --dataset-id and scripts/train_act.sh.
# The key needs datasets.list and data.stream to read a dataset. Uploading needs more: see Foxglove's API key docs.
# No quotes, and never commit the real value.
FOXGLOVE_API_TOKEN=
